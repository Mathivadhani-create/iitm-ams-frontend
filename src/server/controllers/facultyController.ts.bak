import { Response } from 'express';
import { db } from '../db/database';
import { AuthenticatedRequest } from '../middleware/auth';
import { emailService } from '../services/emailService';
import { GradeLetter } from '../types';

const ALLOWED_GRADES: GradeLetter[] = ['A+', 'A', 'A-', 'B+', 'B', 'B-', 'C+', 'C', 'C-', 'D', 'F'];

export const getFacultyProfile = async (req: AuthenticatedRequest, res: Response) => {
  const userId = req.user?.userId;
  const faculty = db.getFacultyByUserId(userId!);

  if (!faculty) {
    return res.status(404).json({ success: false, message: 'Faculty profile not found.' });
  }

  const user = db.getUserById(userId!);

  return res.status(200).json({
    success: true,
    data: {
      ...faculty,
      user,
    },
  });
};

export const getAssignedCourses = async (req: AuthenticatedRequest, res: Response) => {
  const userId = req.user?.userId;
  const faculty = db.getFacultyByUserId(userId!);

  if (!faculty) {
    return res.status(404).json({ success: false, message: 'Faculty record not found.' });
  }

  const allOfferings = db.getCourseOfferings();
  const assigned = allOfferings.filter((co) => co.faculty_id === faculty.id);

  return res.status(200).json({
    success: true,
    data: assigned,
  });
};

export const getEnrolledStudents = async (req: AuthenticatedRequest, res: Response) => {
  const userId = req.user?.userId;
  const faculty = db.getFacultyByUserId(userId!);
  const offeringId = req.params.id;

  if (!faculty) {
    return res.status(404).json({ success: false, message: 'Faculty record not found.' });
  }

  const offering = db.getCourseOfferingById(offeringId);
  if (!offering) {
    return res.status(404).json({ success: false, message: 'Course offering not found.' });
  }

  // BUSINESS RULE 3: Only assigned faculty member can view or upload grades
  if (offering.faculty_id !== faculty.id) {
    return res.status(403).json({
      success: false,
      message: 'Forbidden: You are not assigned as faculty for this course offering.',
    });
  }

  const students = db.getStudentsInOffering(offeringId);

  return res.status(200).json({
    success: true,
    data: {
      offering,
      students,
    },
  });
};

export const uploadGrade = async (req: AuthenticatedRequest, res: Response) => {
  const userId = req.user?.userId;
  const faculty = db.getFacultyByUserId(userId!);
  const offeringId = req.params.id;
  const { registration_id, grade } = req.body;

  if (!faculty) {
    return res.status(404).json({
      success: false,
      message: 'Faculty record not found.',
    });
  }

  const offering = db.getCourseOfferingById(offeringId);

  if (!offering) {
    return res.status(404).json({
      success: false,
      message: 'Course offering not found.',
    });
  }

  // BUSINESS RULE 3: Faculty can only upload grades
  // for courses they are assigned to teach.
  if (offering.faculty_id !== faculty.id) {
    return res.status(403).json({
      success: false,
      message: 'Forbidden: You are not authorized to upload grades for a course you do not teach.',
    });
  }

  // Validate registration ID.
  if (!registration_id) {
    return res.status(400).json({
      success: false,
      message: 'registration_id is required.',
    });
  }

  // Verify that the registration belongs to this course offering.
  const students = db.getStudentsInOffering(offeringId);
  const registration = students.find(
    (student) => student.registration_id === registration_id
  );

  if (!registration) {
    return res.status(404).json({
      success: false,
      message: 'Student registration not found for this course offering.',
    });
  }

  // BUSINESS RULE 9: Grade value validation.
  if (!ALLOWED_GRADES.includes(grade)) {
    return res.status(422).json({
      success: false,
      message: `Invalid grade '${grade}'. Allowed grades are: ${ALLOWED_GRADES.join(', ')}`,
    });
  }

  const updatedGrade = db.upsertGrade(
    registration_id,
    grade,
    faculty.id
  );

  return res.status(200).json({
    success: true,
    message: 'Grade saved successfully.',
    data: updatedGrade,
  });
};

export const updateGrade = async (req: AuthenticatedRequest, res: Response) => {
  const userId = req.user?.userId;
  const faculty = db.getFacultyByUserId(userId!);
  const gradeId = req.params.id;
  const { grade } = req.body;

  if (!faculty) {
    return res.status(404).json({ success: false, message: 'Faculty record not found.' });
  }

  if (!ALLOWED_GRADES.includes(grade)) {
    return res.status(422).json({
      success: false,
      message: `Invalid grade '${grade}'. Allowed grades are: ${ALLOWED_GRADES.join(', ')}`,
    });
  }

  // Find grade
  const allOfferings = db.getCourseOfferings();
  let registrationId: string | null = null;
  let offeringFacultyId: string | null = null;

  for (const offering of allOfferings) {
    const students = db.getStudentsInOffering(offering.id);
    const target = students.find((s) => s.grade?.id === gradeId);
    if (target) {
      registrationId = target.registration_id;
      offeringFacultyId = offering.faculty_id;
      break;
    }
  }

  if (!registrationId || offeringFacultyId !== faculty.id) {
    return res.status(403).json({
      success: false,
      message: 'Grade record not found or you are not authorized to modify it.',
    });
  }

  const updatedGrade = db.upsertGrade(registrationId, grade, faculty.id);

  return res.status(200).json({
    success: true,
    message: 'Grade updated successfully.',
    data: updatedGrade,
  });
};

export const publishGrades = async (req: AuthenticatedRequest, res: Response) => {
  const userId = req.user?.userId;
  const faculty = db.getFacultyByUserId(userId!);
  const offeringId = req.params.id;

  if (!faculty) {
    return res.status(404).json({ success: false, message: 'Faculty record not found.' });
  }

  const offering = db.getCourseOfferingById(offeringId);
  if (!offering) {
    return res.status(404).json({ success: false, message: 'Course offering not found.' });
  }

  if (offering.faculty_id !== faculty.id) {
    return res.status(403).json({
      success: false,
      message: 'Forbidden: You cannot publish grades for a course assigned to another faculty.',
    });
  }

  // 1. Mark grades published in DB
  const publishedGrades = db.publishGradesForOffering(offeringId, faculty.id);

  // 2. Fetch enrolled students and trigger Notifications & Email Service
  const students = db.getStudentsInOffering(offeringId);
  let emailCount = 0;

  for (const s of students) {
    if (s.grade && s.grade.grade) {
      const studentUserId = s.student.user_id;
      const studentName = s.student.user?.name || 'Student';
      const studentEmail = s.student.user?.email || '';

      // In-App Notification
      db.createNotification(
        studentUserId,
        'Grade Published',
        `Your grade for ${offering.course?.course_code} - ${offering.course?.course_name} has been published: ${s.grade.grade}`,
        'grade_published'
      );

      // Email Notification (Gracefully handled inside emailService)
      if (studentEmail) {
        emailService.sendGradeNotification(
          studentEmail,
          studentName,
          offering.course?.course_code || 'COURSE',
          offering.course?.course_name || 'Course',
          s.grade.grade
        );
        emailCount++;
      }
    }
  }

  return res.status(200).json({
    success: true,
    message: `Successfully published grades for ${publishedGrades.length} students. Notifications sent.`,
    data: {
      published_count: publishedGrades.length,
      emails_dispatched: emailCount,
      timestamp: new Date().toISOString(),
    },
  });
};

export const getFacultyNotifications = async (req: AuthenticatedRequest, res: Response) => {
  const userId = req.user?.userId;
  const notifications = db.getNotificationsByUser(userId!);

  return res.status(200).json({
    success: true,
    data: notifications,
  });
};

