# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Auth Configuration
PORT=3000
JWT_SECRET="your-256-bit-secret-key-for-jwt-signing"
JWT_EXPIRATION="24h"
CORS_ORIGIN="*"

# Database (PostgreSQL URL when available, falls back to persistent local storage)
DATABASE_URL="postgresql://user:password@localhost:5432/iitm_ams?sslmode=disable"

# SMTP Email Configuration (Optional - falls back to dev mail logger if disabled)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USERNAME="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM="noreply-ams@iitm.ac.in"
ENABLE_EMAIL=false

