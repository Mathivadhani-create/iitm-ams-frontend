# IIT Madras AMS Go Backend Environment Config
PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/iitm_ams?sslmode=disable
JWT_SECRET=your-256-bit-secret-key-for-jwt-signing
JWT_EXPIRATION_HOURS=24
CORS_ORIGIN=*

# SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_FROM=noreply-ams@iitm.ac.in
ENABLE_EMAIL=false
